# =============================================
# MedLens Backend — PRODUCTION (Render)
# =============================================
# Copy these into Render Dashboard → Web Service → Environment

PORT=5000
NODE_ENV=production

# CORS — your Vercel frontend URL
ALLOWED_ORIGINS=https://medlens.vercel.app

# Optional: Gemini AI API Key (if using AI features)
GEMINI_API_KEY=your_gemini_api_key_here
